# Copy to .env (never commit). Dev values only.
POSTGRES_DB=capacitydesk
POSTGRES_USER=capacitydesk
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5440
# JWT HS256 secret, >= 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=
# Optional LLM adapter (planning assistant falls back to local deterministic one)
GEMINI_API_KEY=

# Optional: static bearer token Prometheus uses to scrape /actuator/prometheus (role METRICS only). Generate: openssl rand -hex 24
METRICS_SCRAPE_TOKEN=
# Optional: enables the LLM narrative in the planning assistant when capacitydesk.assistant.llm.enabled=true
GEMINI_API_KEY=
