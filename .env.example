# Copy to .env (never commit). Dev values only.
POSTGRES_DB=capacitydesk
POSTGRES_USER=capacitydesk
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5440
# JWT HS256 secret, >= 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=
# Optional LLM adapter (planning assistant falls back to local deterministic one)
GEMINI_API_KEY=
