{
 "uid": "rackwise-overview",
 "title": "Rackwise overview",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "15s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Slots used vs limit",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "rackwise_capacity_slots_used",
     "legendFormat": "used",
     "refId": "A"
    },
    {
     "expr": "rackwise_capacity_slots_limit",
     "legendFormat": "limit",
     "refId": "B"
    }
   ]
  },
  {
   "id": 2,
   "title": "Power used vs limit",
   "type": "timeseries",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "rackwise_capacity_power_used_watts",
     "legendFormat": "used",
     "refId": "A"
    },
    {
     "expr": "rackwise_capacity_power_limit_watts",
     "legendFormat": "limit",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "watt"
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "title": "Plan lifecycle events (per 5m)",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (action) (increase(rackwise_audit_events_total{action=~\"PLAN_.*\"}[5m]))",
     "legendFormat": "{{action}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "title": "Denied / failed actions (per 5m)",
   "type": "timeseries",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (action) (increase(rackwise_audit_events_total{result!=\"SUCCESS\"}[5m]))",
     "legendFormat": "{{action}} {{result}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "title": "HTTP request rate by status",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (status) (rate(http_server_requests_seconds_count[1m]))",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "title": "HTTP p95 latency",
   "type": "timeseries",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))",
     "legendFormat": "p95",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "title": "Assistant advice by source / fallbacks",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (source) (increase(assistant_advice_total[5m]))",
     "legendFormat": "advice {{source}}",
     "refId": "A"
    },
    {
     "expr": "sum by (reason) (increase(assistant_fallback_total[5m]))",
     "legendFormat": "fallback {{reason}}",
     "refId": "B"
    }
   ]
  },
  {
   "id": 8,
   "title": "JVM heap used",
   "type": "timeseries",
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
     "legendFormat": "heap",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   }
  }
 ]
}